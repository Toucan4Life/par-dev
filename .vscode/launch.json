{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Par VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "Compile par-vscode",
      "args": [
        "${workspaceFolder:Par Dev}",
        "--user-data-dir=${workspaceFolder:Par Dev}/.vscode/dev-user-data",
        "--extensionDevelopmentPath=${workspaceFolder:par-vscode}"
      ],
      "outFiles": [
        "${workspaceFolder:par-vscode}/out/**/*.js"
      ]
    }
  ]
}